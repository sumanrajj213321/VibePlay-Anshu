      }
    }

    match /gift_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (
        request.auth.uid in existing().participantIds ||
        (existing().roomId is string &&
         exists(/databases/$(database)/documents/rooms/$(existing().roomId)/room_sessions/$(request.auth.uid)))
      );
      allow list: if isSignedIn() && (
        request.auth.uid in existing().participantIds ||
        (existing().roomId is string &&
         exists(/databases/$(database)/documents/rooms/$(existing().roomId)/room_sessions/$(request.auth.uid)))
      );
      allow create: if isSignedIn() && isValidId(txId) &&
                       incoming().senderId == request.auth.uid &&
                       request.auth.uid in incoming().participantIds &&
                       isValidGiftTransaction(incoming()) &&
                       isTrustedGiftPrice(incoming()) &&
                       giftMatchesCoinUpdates(incoming()) &&
                       isValidTs(incoming().createdAt);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().recipientId == request.auth.uid);
      allow list: if isSignedIn() && (existing().recipientId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(notificationId) &&
                       incoming().senderId == request.auth.uid &&
                       isValidNotification(incoming()) &&
                       isValidTs(incoming().createdAt);
      allow update: if isSignedIn() && isValidId(notificationId) &&
                       existing().recipientId == request.auth.uid &&
                       isValidNotification(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && existing().recipientId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid);
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       isValidReport(incoming()) &&
                       isValidTs(incoming().createdAt) &&
                       isValidTs(incoming().updatedAt);
      allow update, delete: if false;
    }


    // Free-tier client invitation path. Pair familiarity and activation remain Admin-worker controlled.
    match /relationship_invites/{pairId} {
      allow get: if isSignedIn() &&
        (existing().inviterId == request.auth.uid || existing().invitedTo == request.auth.uid);
      allow list: if false;
      allow create: if validRelationshipInvite(pairId);
      allow update: if (
        validRelationshipInvite(pairId) &&
        canReplaceRelationshipInvite(pairId) &&
        incoming().inviterId == request.auth.uid
      ) || (
        isSignedIn() &&
        existing().invitedTo == request.auth.uid &&
        existing().status == 'PENDING' &&
        incoming().pairId == existing().pairId &&
        incoming().inviterId == existing().inviterId &&
        incoming().invitedTo == existing().invitedTo &&
        incoming().tagType == existing().tagType &&
        incoming().notificationId == existing().notificationId &&
        incoming().status in ['ACCEPTED', 'REJECTED'] &&
        incoming().respondedAt == request.time &&
        existing().expiresAt is timestamp && existing().expiresAt > request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'respondedAt']));
      allow delete: if false;
    }

    // Relationship familiarity is written only by the trusted gift trigger.
    match /relationship_pairs/{pairId} {
      allow get, list: if isSignedIn() &&
        request.auth.uid in existing().userIds;
      allow create, update, delete: if false;
    }

    // Public, minimal relationship card projection; only trusted Functions may write it.
    match /relationship_links/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Public tag cards contain only profile-safe names, avatars and tag type.
    match /relationship_public_tags/{pairId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /relationship_profile_selection/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      // Users may feature only an existing ACTIVE pair they belong to.
      // Pair familiarity and relationship status remain server-worker controlled.
      allow create, update: if isSignedIn() &&
        request.auth.uid == userId &&
        incoming().userId == userId &&
        incoming().partnerId is string &&
        incoming().partnerId != userId &&
        incoming().pairId is string &&
        incoming().keys().hasOnly(['userId', 'partnerId', 'pairId', 'updatedAt']) &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/relationship_pairs/$(incoming().pairId)) &&
        get(/databases/$(database)/documents/relationship_pairs/$(incoming().pairId)).data.tagStatus == 'ACTIVE' &&
        userId in get(/databases/$(database)/documents/relationship_pairs/$(incoming().pairId)).data.userIds &&
        incoming().partnerId in get(/databases/$(database)/documents/relationship_pairs/$(incoming().pairId)).data.userIds;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /relationship_gift_events/{eventId} {
      allow read, write: if false;
    }

    match /gifts_catalog/{giftId} {
      allow get: if isSignedIn() && isValidId(giftId) && (existing().active == true);
      allow list: if isSignedIn() && (existing().active == true);
      allow create, update, delete: if false;
    }
  }
}
) &&
                         isValidTs(incoming().updatedAt);
        allow update: if isSignedIn() && request.auth.uid == userId && gameId == 'fruit_treasure' &&
                         incoming().keys().hasOnly(['score', 'spins', 'dailyBonusDate', 'updatedAt']) &&
                         incoming().score is int && incoming().score >= existing().score &&
                         incoming().score <= 1000000000 &&
                         incoming().spins is int && incoming().spins >= existing().spins &&
                         incoming().spins <= 10000000 &&
                         incoming().dailyBonusDate is string && incoming().dailyBonusDate.matches('^([0-9]{8})?
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(targetId) &&
                                 request.auth.uid == userId &&
                                 incoming().peerId == targetId &&
                                 isValidFollowEdge(incoming()) &&
                                 isValidTs(incoming().createdAt);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /followers/{followerId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(followerId) &&
                                 request.auth.uid == followerId &&
                                 incoming().peerId == followerId &&
                                 isValidFollowEdge(incoming()) &&
                                 isValidTs(incoming().createdAt);
        allow delete: if isSignedIn() && (request.auth.uid == followerId || request.auth.uid == userId);
      }
    }

    match /room_creation_locks/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidRoomCreationLock(incoming(), userId) &&
                       isValidTs(incoming().createdAt) &&
                       existsAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)) &&
                       (getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.hostId == request.auth.uid ||
                        effectiveRoomOwnerId(getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data) == request.auth.uid);
      allow update, delete: if false;
    }

    match /room_public_ids/{publicRoomId} {
      allow get: if isSignedIn() && publicRoomId.matches('^[0-9]{6}$');
      allow list: if false;
      allow create: if isSignedIn() &&
                       publicRoomId.matches('^[0-9]{6}$') &&
                       isValidId(incoming().roomId) &&
                       isValidTs(incoming().createdAt) &&
                       existsAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)) &&
                       getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.publicRoomId == publicRoomId &&
                       getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.hostId == request.auth.uid;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (existing().status == 'LIVE' || isRoomManager(existing()));
      allow list: if isSignedIn() && (existing().status == 'LIVE' || isRoomManager(existing()));

      allow create: if isSignedIn() && isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().hostId == request.auth.uid &&
                       (!('ownerId' in incoming()) || incoming().ownerId == request.auth.uid) &&
                       (!('creatorId' in incoming()) || incoming().creatorId == request.auth.uid) &&
                       incoming().status == 'LIVE' &&
                       incoming().featured == false &&
                       isValidTs(incoming().createdAt) &&
                       isValidTs(incoming().updatedAt) &&
                       !exists(/databases/$(database)/documents/room_creation_locks/$(request.auth.uid)) &&
                       (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
                        !('hasCreatedRoom' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasCreatedRoom == false) &&
                       existsAfter(/databases/$(database)/documents/room_creation_locks/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/room_creation_locks/$(request.auth.uid)).data.roomId == roomId &&
                       (!('publicRoomId' in incoming()) ||
                        (existsAfter(/databases/$(database)/documents/room_public_ids/$(incoming().publicRoomId)) &&
                         getAfter(/databases/$(database)/documents/room_public_ids/$(incoming().publicRoomId)).data.roomId == roomId));

      allow update: if isSignedIn() && isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (!('creatorId' in existing()) || incoming().creatorId == existing().creatorId) &&
                       isValidTs(incoming().updatedAt) && (
        (isRoomOwner(existing()) && existing().status == 'LIVE' &&
         incoming().featured == existing().featured &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'announcement', 'category', 'coverKey', 'coverUrl', 'tags', 'locked', 'hasPassword', 'passcodeHash', 'status', 'hostId', 'hostName', 'hostAvatarUrl', 'ownerId', 'ownerName', 'ownerOnline', 'adminIds', 'activeAdminIds', 'listenerCount', 'activeSpeakersCount', 'updatedAt'])) ||
        (isRoomAdminUser(existing()) && existing().status == 'LIVE' &&
         incoming().hostId == existing().hostId &&
         (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId) &&
         (!('ownerOnline' in existing()) || incoming().ownerOnline == existing().ownerOnline) &&
         (!('adminIds' in existing()) || incoming().adminIds == existing().adminIds) &&
         incoming().featured == existing().featured &&
         (incoming().status == existing().status || (incoming().status == 'ENDED' && (!('ownerOnline' in existing()) || existing().ownerOnline == false))) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'announcement', 'category', 'coverKey', 'coverUrl', 'tags', 'locked', 'hasPassword', 'passcodeHash', 'listenerCount', 'activeSpeakersCount', 'activeAdminIds', 'status', 'updatedAt'])) ||
        (existing().status == 'LIVE' &&
         isDirectSpeakerSeatJoin(roomId, incoming()) &&
         incoming().status == existing().status &&
         incoming().hostId == existing().hostId &&
         incoming().featured == existing().featured &&
         incoming().listenerCount == (exists(/databases/$(database)/documents/rooms/$(roomId)/listeners/$(request.auth.uid)) ? (existing().listenerCount > 0 ? existing().listenerCount - 1 : 0) : existing().listenerCount) &&
         incoming().activeSpeakersCount == (existing().activeSpeakersCount < 9 ? existing().activeSpeakersCount + 1 : 9) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['listenerCount', 'activeSpeakersCount', 'lastSpeakerSeatJoinUserId', 'lastSpeakerSeatJoinSeatIndex', 'updatedAt'])) ||
        (existing().status == 'LIVE' && incoming().hostId == existing().hostId &&
         (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId) &&
         (!('ownerOnline' in existing()) || incoming().ownerOnline == existing().ownerOnline) &&
         (!('adminIds' in existing()) || incoming().adminIds == existing().adminIds) &&
         incoming().featured == existing().featured &&
         (incoming().status == existing().status ||
          (incoming().status == 'ENDED' &&
           (!('ownerOnline' in existing()) || existing().ownerOnline == false) &&
           (!('activeAdminIds' in incoming()) || incoming().activeAdminIds.size() == 0))) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['listenerCount', 'activeSpeakersCount', 'activeAdminIds', 'status', 'updatedAt']))
      );

      allow delete: if isSignedIn() && isValidId(roomId) && (
        isRoomOwner(existing()) ||
        (isRoomAdminUser(existing()) && (!('ownerOnline' in existing()) || existing().ownerOnline == false))
      );

      // Strict 9-Seat Stage: 0 = Host, 1..8 = 8 Regular Speaker Seats
      match /seats/{seatIndex} {
        allow get: if isSignedIn() && seatIndex in ['0', '1', '2', '3', '4', '5', '6', '7', '8'];
        allow list: if isSignedIn() && existing().seatIndex >= 0 && existing().seatIndex <= 8;

        allow create: if isSignedIn() &&
                         seatIndex in ['0', '1', '2', '3', '4', '5', '6', '7', '8'] &&
                         isValidSeat(incoming(), seatIndex) &&
                         isValidTs(incoming().updatedAt) &&
                         getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid &&
                         (seatIndex != '0' || incoming().occupantId == request.auth.uid);

        allow update: if isSignedIn() &&
                         seatIndex in ['0', '1', '2', '3', '4', '5', '6', '7', '8'] &&
                         isValidSeat(incoming(), seatIndex) &&
                         isValidTs(incoming().updatedAt) &&
                         (seatIndex != '0' ||
                          incoming().occupantId == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId ||
                          incoming().occupantId == effectiveRoomOwnerId(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data)) &&
                         (seatIndex == '0' || existing().occupantId == '' || incoming().occupantId == '' || incoming().occupantId == existing().occupantId) && (
          (isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
           (seatIndex == '0' ||
            incoming().occupantId == existing().occupantId ||
            incoming().occupantId == '')) ||
          (seatIndex != '0' && (
            (existing().occupantId == request.auth.uid &&
             (incoming().occupantId == request.auth.uid || incoming().occupantId == '') &&
             incoming().seatLocked == existing().seatLocked &&
             incoming().diff(existing()).affectedKeys().hasOnly(['occupantId', 'occupantName', 'occupantAvatarUrl', 'occupantVipLevel', 'occupantGender', 'muted', 'speaking', 'updatedAt'])) ||
            (existing().occupantId == '' && existing().seatLocked == false &&
             incoming().occupantId == request.auth.uid &&
             incoming().seatLocked == false &&
             exists(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)) &&
