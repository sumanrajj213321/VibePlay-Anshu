rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTs(ts) {
      return ts is timestamp && ts <= request.time;
    }


    function isNotAlreadyOnAnotherSpeakerSeat(roomId, seatIndex) {
      return (seatIndex == '1' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/1).data.occupantId != request.auth.uid) &&
             (seatIndex == '2' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/2).data.occupantId != request.auth.uid) &&
             (seatIndex == '3' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/3).data.occupantId != request.auth.uid) &&
             (seatIndex == '4' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/4).data.occupantId != request.auth.uid) &&
             (seatIndex == '5' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/5).data.occupantId != request.auth.uid) &&
             (seatIndex == '6' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/6).data.occupantId != request.auth.uid) &&
             (seatIndex == '7' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/7).data.occupantId != request.auth.uid) &&
             (seatIndex == '8' || get(/databases/$(database)/documents/rooms/$(roomId)/seats/8).data.occupantId != request.auth.uid);
    }
    function isDirectSpeakerSeatJoin(roomId, roomData) {
      let seatIndex = ('lastSpeakerSeatJoinSeatIndex' in roomData) ? roomData.lastSpeakerSeatJoinSeatIndex : -1;
      return ('lastSpeakerSeatJoinUserId' in roomData) &&
             roomData.lastSpeakerSeatJoinUserId == request.auth.uid &&
             seatIndex is int && seatIndex >= 1 && seatIndex <= 8 &&
             getAfter(/databases/$(database)/documents/rooms/$(roomId)/seats/$(seatIndex)).data.occupantId == request.auth.uid &&
             get(/databases/$(database)/documents/rooms/$(roomId)/seats/$(seatIndex)).data.occupantId == '';
    }

    // --- Validation Helpers ---

    function shopFramePrice(itemId) {
      return itemId == 'neon_cyan' ? 15000 :
             itemId == 'rose_gold' ? 25000 :
             itemId == 'royal_gold' ? 40000 :
             itemId == 'galaxy' ? 60000 :
             itemId == 'aurora' ? 80000 : -1;
    }

    function isValidFramePurchase(data, oldData) {
      return data.vipLevel == oldData.vipLevel &&
             data.coinBalance is int &&
             data.coinBalance >= 0 &&
             data.coinBalance < oldData.coinBalance &&
             data.ownedFrameIds is list &&
             data.ownedFrameIds.hasAll(('ownedFrameIds' in oldData) ? oldData.ownedFrameIds : []) &&
             data.ownedFrameIds.size() >= (('ownedFrameIds' in oldData) ? oldData.ownedFrameIds.size() : 0) &&
             data.ownedFrameIds.size() <= (('ownedFrameIds' in oldData) ? oldData.ownedFrameIds.size() : 0) + 1 &&
             data.activeFrameId is string &&
             data.activeFrameId in data.ownedFrameIds &&
             data.frameExpiresAt is map &&
             data.frameExpiresAt[data.activeFrameId] is timestamp &&
             data.frameExpiresAt[data.activeFrameId] > request.time - duration.value(1, 'm') &&
             data.frameExpiresAt[data.activeFrameId] <= request.time + duration.value(7, 'd') + duration.value(1, 'm') &&
             shopFramePrice(data.activeFrameId) >= 0 &&
             data.coinBalance == oldData.coinBalance - shopFramePrice(data.activeFrameId) &&
             data.diff(oldData).affectedKeys().hasOnly(['coinBalance', 'ownedFrameIds', 'activeFrameId', 'frameExpiresAt', 'lastFramePurchaseAt', 'updatedAt']);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.vibeId is string && data.vibeId.size() >= 3 && data.vibeId.size() <= 24 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 30 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 500)) &&
             (!('gender' in data) || data.gender in ['UNSPECIFIED', 'FEMALE', 'MALE', 'NON_BINARY']) &&
             (!('age' in data) || (data.age is int && (data.age == 0 || (data.age >= 13 && data.age <= 120)))) &&
             (!('ageRange' in data) || data.ageRange in ['HIDDEN', '18-24', '25-34', '35-44', '45+']) &&
             (!('showAge' in data) || data.showAge is bool) &&
             (!('showGender' in data) || data.showGender is bool) &&
             (!('showOnlineStatus' in data) || data.showOnlineStatus is bool) &&
             (!('online' in data) || data.online is bool) &&
             (!('level' in data) || (data.level is int && data.level >= 1 && data.level <= 999)) &&
             (!('xp' in data) || (data.xp is int && data.xp >= 0)) &&
             data.vipLevel is int && data.vipLevel >= 0 && data.vipLevel <= 30 &&
             (!('ownedTitleIds' in data) || (data.ownedTitleIds is list && data.ownedTitleIds.size() <= 20)) &&
             (!('activeTitleId' in data) || (data.activeTitleId is string && data.activeTitleId.size() <= 40)) &&
             (!('ownedFrameIds' in data) || (data.ownedFrameIds is list && data.ownedFrameIds.size() <= 20)) &&
             (!('activeFrameId' in data) || (data.activeFrameId is string && data.activeFrameId.size() <= 40)) &&
             (!('vipExpiresAt' in data) || data.vipExpiresAt is timestamp) &&
             (!('titleExpiresAt' in data) || data.titleExpiresAt is map) &&
             (!('frameExpiresAt' in data) || data.frameExpiresAt is map) &&
             data.coinBalance is int && data.coinBalance >= 0 &&
             (!('totalGiftsReceived' in data) || (data.totalGiftsReceived is int && data.totalGiftsReceived >= 0)) &&
             (!('totalGiftsSent' in data) || (data.totalGiftsSent is int && data.totalGiftsSent >= 0)) &&
             (!('totalGiftCoinsSent' in data) || (data.totalGiftCoinsSent is int && data.totalGiftCoinsSent >= 0)) &&
             (!('totalGiftCoinsReceived' in data) || (data.totalGiftCoinsReceived is int && data.totalGiftCoinsReceived >= 0)) &&
             (!('followersCount' in data) || (data.followersCount is int && data.followersCount >= 0)) &&
             (!('followingCount' in data) || (data.followingCount is int && data.followingCount >= 0)) &&
             data.accountStatus in ['ACTIVE', 'SUSPENDED', 'BANNED'] &&
             data.role == 'USER' &&
             (!('lastDailyClaimDay' in data) || (data.lastDailyClaimDay is string && data.lastDailyClaimDay.size() <= 20)) &&
             (!('lastDailyClaimAt' in data) || data.lastDailyClaimAt is timestamp) &&
             (!('hasCreatedRoom' in data) || data.hasCreatedRoom is bool) &&
             (!('createdRoomId' in data) || (data.createdRoomId is string && data.createdRoomId.size() <= 128));
    }

    function isValidPrivateAccount(data, userId) {
      return data.userId == userId &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('blockedUserIds' in data) || (data.blockedUserIds is list && data.blockedUserIds.size() <= 200 && (data.blockedUserIds.size() == 0 || data.blockedUserIds[0] is string))) &&
             (!('pinnedConversationIds' in data) || (data.pinnedConversationIds is list && data.pinnedConversationIds.size() <= 100 && (data.pinnedConversationIds.size() == 0 || data.pinnedConversationIds[0] is string)));
    }

    function isValidFollowEdge(data) {
      return data.peerId is string && data.peerId.size() >= 1 && data.peerId.size() <= 128 &&
             data.peerName is string && data.peerName.size() >= 1 && data.peerName.size() <= 60 &&
             (!('peerAvatarUrl' in data) || (data.peerAvatarUrl is string && data.peerAvatarUrl.size() <= 500)) &&
             (!('peerGender' in data) || data.peerGender in ['UNSPECIFIED', 'FEMALE', 'MALE', 'NON_BINARY']);
    }

    function isValidRoomCreationLock(data, userId) {
      return data.userId == userId &&
             isValidId(data.roomId);
    }

    function effectiveRoomOwnerId(roomData) {
      return ('ownerId' in roomData && roomData.ownerId is string && roomData.ownerId.size() > 0)
        ? roomData.ownerId
        : roomData.hostId;
    }

    function isRoomOwner(roomData) {
      return effectiveRoomOwnerId(roomData) == request.auth.uid || roomData.hostId == request.auth.uid;
    }

    function isRoomAdminUser(roomData) {
      return 'adminIds' in roomData && roomData.adminIds is list && request.auth.uid in roomData.adminIds;
    }

    function isRoomManager(roomData) {
      return isRoomOwner(roomData) || isRoomAdminUser(roomData);
    }

    function isValidRoom(data) {
      return (!('publicRoomId' in data) || (data.publicRoomId is string && data.publicRoomId.matches('^[0-9]{6}$'))) &&
             (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128)) &&
             data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             (!('hostAvatarUrl' in data) || (data.hostAvatarUrl is string && data.hostAvatarUrl.size() <= 500)) &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 60)) &&
             (!('ownerOnline' in data) || data.ownerOnline is bool) &&
             (!('adminIds' in data) || (data.adminIds is list && data.adminIds.size() <= 20 && (data.adminIds.size() == 0 || data.adminIds[0] is string))) &&
             (!('activeAdminIds' in data) || (data.activeAdminIds is list && data.activeAdminIds.size() <= 20 && (data.activeAdminIds.size() == 0 || data.activeAdminIds[0] is string))) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 60 &&
             (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 200)) &&
             data.category in ['Chill', 'Music', 'Gaming', 'Dating', 'Karaoke', 'Chat'] &&
             (!('coverKey' in data) || (data.coverKey is string && data.coverKey.size() <= 120)) &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 1000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 5 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             (!('listenerCount' in data) || (data.listenerCount is int && data.listenerCount >= 0)) &&
             (!('activeSpeakersCount' in data) || (data.activeSpeakersCount is int && data.activeSpeakersCount >= 0 && data.activeSpeakersCount <= 9)) &&
             data.locked is bool &&
             data.hasPassword is bool &&
             (!('passcodeHash' in data) || (data.passcodeHash is string && data.passcodeHash.size() <= 128)) &&
             data.status in ['LIVE', 'ENDED'] &&
             (!('featured' in data) || data.featured is bool);
    }

    function isValidSeat(data, seatIndex) {
      return data.seatIndex is int &&
             data.occupantId is string && data.occupantId.size() <= 128 &&
             (!('occupantName' in data) || (data.occupantName is string && data.occupantName.size() <= 60)) &&
             (!('occupantAvatarUrl' in data) || (data.occupantAvatarUrl is string && data.occupantAvatarUrl.size() <= 500)) &&
             (!('occupantVipLevel' in data) || (data.occupantVipLevel is int && data.occupantVipLevel >= 0 && data.occupantVipLevel <= 30)) &&
             (!('occupantGender' in data) || (data.occupantGender is string && data.occupantGender.size() <= 24)) &&
             data.muted is bool &&
             (!('seatLocked' in data) || data.seatLocked is bool) &&
             data.speaking is bool &&
             (
               (seatIndex == '0' && data.seatIndex == 0 && data.role == 'HOST' && data.occupantId.size() > 0) ||
               (seatIndex in ['1', '2', '3', '4', '5', '6', '7', '8'] && data.seatIndex >= 1 && data.seatIndex <= 8 && data.role == 'SPEAKER')
             );
    }

    function isValidSpeakerRequest(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 60 &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('vipLevel' in data) || (data.vipLevel is int && data.vipLevel >= 0 && data.vipLevel <= 30)) &&
             (!('preferredSeatIndex' in data) || (data.preferredSeatIndex is int && data.preferredSeatIndex >= 0 && data.preferredSeatIndex <= 8)) &&
             data.status in ['INVITED', 'ACCEPTED', 'APPROVED', 'REJECTED'];
    }

    function isValidRoomMessage(data) {
      return data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             (!('senderVipLevel' in data) || (data.senderVipLevel is int && data.senderVipLevel >= 0 && data.senderVipLevel <= 30)) &&
             (!('senderGender' in data) || (data.senderGender is string && data.senderGender.size() <= 24)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
             data.type in ['TEXT', 'GIFT', 'SYSTEM'] &&
             (!('giftId' in data) || (data.giftId is string && data.giftId.size() <= 128)) &&
             (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 60)) &&
             (!('giftCoins' in data) || (data.giftCoins is int && data.giftCoins >= 0)) &&
             (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 60));
    }

    function isValidRoomListener(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 60 &&
             data.role == 'LISTENER' &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('vipLevel' in data) || (data.vipLevel is int && data.vipLevel >= 0 && data.vipLevel <= 30)) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 24));
    }

    function isValidConversation(data) {
      return data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 &&
             data.participantIds[0] is string &&
             (!('conversationType' in data) || data.conversationType in ['DIRECT', 'GROUP']) &&
             (!('groupName' in data) || (data.groupName is string && data.groupName.size() <= 60)) &&
             (!('groupAvatarUrl' in data) || (data.groupAvatarUrl is string && data.groupAvatarUrl.size() <= 500)) &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
             (!('adminIds' in data) || (data.adminIds is list && data.adminIds.size() <= 50 && (data.adminIds.size() == 0 || data.adminIds[0] is string))) &&
             data.lastMessage is string && data.lastMessage.size() <= 400 &&
             data.lastSenderId is string && data.lastSenderId.size() <= 128 &&
             (!('unreadBy' in data) || (data.unreadBy is list && data.unreadBy.size() <= 50)) &&
             (!('participantNames' in data) || data.participantNames is map) &&
             (!('participantAvatars' in data) || data.participantAvatars is map);
    }

    function isValidDirectMessage(data) {
      return data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 60)) &&
             (!('senderAvatarUrl' in data) || (data.senderAvatarUrl is string && data.senderAvatarUrl.size() <= 500)) &&
             (!('senderGender' in data) || data.senderGender in ['UNSPECIFIED', 'FEMALE', 'MALE', 'NON_BINARY']) &&
             data.type in ['TEXT', 'IMAGE', 'SYSTEM'] &&
             data.text is string && data.text.size() <= 1000 &&
             (!('imageUri' in data) || (data.imageUri is string && data.imageUri.size() <= 600)) &&
             data.read is bool;
    }

    function defaultGiftUnitPrice(giftId) {
      return giftId == 'gift_rose' ? 10 :
             giftId == 'gift_mic' ? 25 :
             giftId == 'gift_fire' ? 50 :
             giftId == 'gift_party' ? 100 :
             giftId == 'gift_heart' ? 180 :
             giftId == 'gift_crown' ? 500 :
             giftId == 'gift_rocket' ? 999 :
             giftId == 'gift_diamond' ? 1500 : -1;
    }

    function isTrustedGiftPrice(data) {
      return (
        exists(/databases/$(database)/documents/gifts_catalog/$(data.giftId)) &&
        get(/databases/$(database)/documents/gifts_catalog/$(data.giftId)).data.active == true &&
        get(/databases/$(database)/documents/gifts_catalog/$(data.giftId)).data.coinCost is int &&
        data.coinCost == get(/databases/$(database)/documents/gifts_catalog/$(data.giftId)).data.coinCost * data.quantity
      ) || (
        !exists(/databases/$(database)/documents/gifts_catalog/$(data.giftId)) &&
        defaultGiftUnitPrice(data.giftId) > 0 &&
        data.coinCost == defaultGiftUnitPrice(data.giftId) * data.quantity
      );
    }

    function giftMatchesCoinUpdates(data) {
      let senderBefore = get(/databases/$(database)/documents/users/$(data.senderId)).data;
      let senderAfter = getAfter(/databases/$(database)/documents/users/$(data.senderId)).data;
      let senderSent = ('totalGiftsSent' in senderBefore) ? senderBefore.totalGiftsSent : 0;
      let senderGiftCoins = ('totalGiftCoinsSent' in senderBefore) ? senderBefore.totalGiftCoinsSent : 0;
      return senderAfter.coinBalance == senderBefore.coinBalance - data.coinCost &&
             senderAfter.totalGiftsSent == senderSent + data.quantity &&
             senderAfter.totalGiftCoinsSent == senderGiftCoins + data.coinCost &&
             (
               data.recipientId == data.senderId ||
               (
                 getAfter(/databases/$(database)/documents/users/$(data.recipientId)).data.totalGiftsReceived ==
                   (('totalGiftsReceived' in get(/databases/$(database)/documents/users/$(data.recipientId)).data)
                     ? get(/databases/$(database)/documents/users/$(data.recipientId)).data.totalGiftsReceived : 0) + data.quantity &&
                 getAfter(/databases/$(database)/documents/users/$(data.recipientId)).data.totalGiftCoinsReceived ==
                   (('totalGiftCoinsReceived' in get(/databases/$(database)/documents/users/$(data.recipientId)).data)
                     ? get(/databases/$(database)/documents/users/$(data.recipientId)).data.totalGiftCoinsReceived : 0) + data.coinCost
               )
             );
    }

    function isValidGiftTransaction(data) {
      return data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 60 &&
             (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
             data.giftId is string && data.giftId.size() >= 1 && data.giftId.size() <= 128 &&
             data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 60 &&
             data.coinCost is int && data.coinCost >= 1 &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 999 &&
             data.participantIds is list && data.participantIds.size() == 2;
    }

    function isValidNotification(data) {
      return data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 60)) &&
             data.type in ['FOLLOW', 'FRIEND_REQUEST', 'MESSAGE', 'ROOM_INVITE', 'GIFT', 'SYSTEM', 'RELATIONSHIP_INVITE'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 240 &&
             (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
             data.read is bool;
    }

    function isValidReport(data) {
      return data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
             (!('reporterName' in data) || (data.reporterName is string && data.reporterName.size() <= 60)) &&
             data.targetType in ['USER', 'ROOM', 'MESSAGE'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 100)) &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 100 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
             data.status in ['OPEN', 'REVIEWED', 'DISMISSED', 'ACTION_TAKEN'];
    }

    function isValidGiftCatalogItem(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.category in ['Popular', 'Luxury', 'Romantic', 'Party'] &&
             data.coinCost is int && data.coinCost >= 1 && data.coinCost <= 1000000 &&
             data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16 &&
             (!('accentColorHex' in data) || (data.accentColorHex is string && data.accentColorHex.size() <= 12)) &&
             data.active is bool;
    }

    function isAllowedRelationshipTag(tagType) {
      return tagType in ['BUDDIES', 'BRO', 'CONFIDANT', 'BESTIE'];
    }

    function relationshipPairAllowsInvite(pairId) {
      let pairPath = /databases/$(database)/documents/relationship_pairs/$(pairId);
      return !exists(pairPath) ||
        (
          (!('tagStatus' in get(pairPath).data) ||
           !(get(pairPath).data.tagStatus in ['ACTIVE', 'WAITING_FAMILIARITY', 'PENDING'])) &&
          (!('tagCooldownUntil' in get(pairPath).data) ||
           get(pairPath).data.tagCooldownUntil <= request.time)
        );
    }

    function validRelationshipInvite(pairId) {
      return isSignedIn() &&
        pairId.matches('^[a-f0-9]{64}$') &&
        incoming().pairId == pairId &&
        incoming().inviterId == request.auth.uid &&
        incoming().invitedTo is string &&
        incoming().invitedTo.size() >= 1 &&
        incoming().invitedTo.size() <= 128 &&
        incoming().invitedTo != request.auth.uid &&
        isAllowedRelationshipTag(incoming().tagType) &&
        incoming().status == 'PENDING' &&
        incoming().notificationId is string &&
        incoming().notificationId.size() >= 1 &&
        incoming().inviterName is string &&
        incoming().inviterName.size() <= 60 &&
        incoming().invitedName is string &&
        incoming().invitedName.size() <= 60 &&
        incoming().inviterAvatarUrl is string &&
        incoming().inviterAvatarUrl.size() <= 2048 &&
        incoming().invitedAvatarUrl is string &&
        incoming().invitedAvatarUrl.size() <= 2048 &&
        incoming().keys().hasOnly([
          'pairId', 'inviterId', 'invitedTo', 'inviterName', 'invitedName',
          'inviterAvatarUrl', 'invitedAvatarUrl', 'tagType', 'status',
          'notificationId', 'createdAt', 'expiresAt'
        ]) &&
        incoming().createdAt == request.time &&
        incoming().expiresAt is timestamp &&
        incoming().expiresAt > request.time &&
        // Allow a small client/server clock-skew margin while the app still sets a 48-hour expiry.
        incoming().expiresAt <= request.time + duration.value(48, 'h') + duration.value(2, 'm') &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(incoming().invitedTo)) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'ACTIVE' &&
        exists(/databases/$(database)/documents/users/$(incoming().invitedTo)) &&
        get(/databases/$(database)/documents/users/$(incoming().invitedTo)).data.accountStatus == 'ACTIVE' &&
        relationshipPairAllowsInvite(pairId) &&
        existsAfter(/databases/$(database)/documents/notifications/$(incoming().notificationId)) &&
        getAfter(/databases/$(database)/documents/notifications/$(incoming().notificationId)).data.senderId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/notifications/$(incoming().notificationId)).data.recipientId == incoming().invitedTo &&
        getAfter(/databases/$(database)/documents/notifications/$(incoming().notificationId)).data.type == 'RELATIONSHIP_INVITE' &&
        getAfter(/databases/$(database)/documents/notifications/$(incoming().notificationId)).data.targetId == pairId;
    }

    function canReplaceRelationshipInvite(pairId) {
      return existing().status == 'REJECTED' ||
        (existing().status == 'PENDING' &&
         existing().expiresAt is timestamp &&
         existing().expiresAt <= request.time) ||
        (existing().status == 'ACCEPTED' &&
         exists(/databases/$(database)/documents/relationship_pairs/$(pairId)) &&
         get(/databases/$(database)/documents/relationship_pairs/$(pairId)).data.tagStatus == 'BROKEN' &&
         'tagCooldownUntil' in get(/databases/$(database)/documents/relationship_pairs/$(pairId)).data &&
         get(/databases/$(database)/documents/relationship_pairs/$(pairId)).data.tagCooldownUntil <= request.time);
    }

    // --- Collection Rules ---


    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || existing().accountStatus == 'ACTIVE'
      );
      allow list: if isSignedIn() && (existing().accountStatus == 'ACTIVE');

      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().role == 'USER' &&
                       incoming().accountStatus == 'ACTIVE' &&
                       incoming().vipLevel == 0 &&
                       incoming().coinBalance == 1000500 &&
                       incoming().welcomeBonusGranted == true &&
                       (!('hasCreatedRoom' in incoming()) || incoming().hasCreatedRoom == false) &&
                       (!('createdRoomId' in incoming()) || incoming().createdRoomId == '') &&
                       incoming().keys().hasAll(['userId', 'vibeId', 'username', 'accountStatus', 'role', 'coinBalance', 'vipLevel', 'createdAt', 'updatedAt']) &&
                       isValidTs(incoming().createdAt) &&
                       isValidTs(incoming().updatedAt);

      allow update: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().diff(existing()).affectedKeys().hasAny(['lastFramePurchaseAt']) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().role == existing().role &&
                       incoming().accountStatus == existing().accountStatus &&
                       isValidTs(incoming().updatedAt) &&
                       isValidFramePurchase(incoming(), existing());

      allow update: if isSignedIn() && isValidId(userId) &&
                       !incoming().diff(existing()).affectedKeys().hasAny(['lastFramePurchaseAt']) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTs(incoming().updatedAt) && (
        
        (request.auth.uid == userId && incoming().role == existing().role && incoming().accountStatus == existing().accountStatus && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bio', 'avatarUrl', 'coverUrl', 'gender', 'genderChangeCount', 'age', 'ageRange', 'showAge', 'showGender', 'showOnlineStatus', 'online', 'followingCount', 'followersCount', 'updatedAt']) &&
           isValidUserProfile(incoming()) &&
           incoming().coinBalance == existing().coinBalance && incoming().vipLevel == existing().vipLevel &&
           ((incoming().gender == (('gender' in existing()) ? existing().gender : 'UNSPECIFIED') &&
             incoming().genderChangeCount == (('genderChangeCount' in existing()) ? existing().genderChangeCount : 0)) ||
            ((('gender' in existing()) ? existing().gender : 'UNSPECIFIED') == 'UNSPECIFIED' &&
             (('genderChangeCount' in existing()) ? existing().genderChangeCount : 0) == 0 &&
             incoming().gender in ['FEMALE', 'MALE', 'NON_BINARY'] &&
             incoming().genderChangeCount == 1))) ||
          (incoming().coinBalance == existing().coinBalance && incoming().vipLevel == existing().vipLevel &&
           incoming().followingCount is int && incoming().followingCount >= 0 &&
           incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt'])) ||
          ((!('hasCreatedRoom' in existing()) || existing().hasCreatedRoom == false) &&
           incoming().hasCreatedRoom == true &&
           isValidId(incoming().createdRoomId) &&
           incoming().coinBalance == existing().coinBalance && incoming().vipLevel == existing().vipLevel &&
           existsAfter(/databases/$(database)/documents/room_creation_locks/$(userId)) &&
           getAfter(/databases/$(database)/documents/room_creation_locks/$(userId)).data.roomId == incoming().createdRoomId &&
           incoming().diff(existing()).affectedKeys().hasOnly(['hasCreatedRoom', 'createdRoomId', 'updatedAt'])) ||
          (incoming().vipLevel == existing().vipLevel && incoming().coinBalance == existing().coinBalance + 150 &&
           incoming().lastDailyClaimDay is string &&
           (!('lastDailyClaimDay' in existing()) || incoming().lastDailyClaimDay != existing().lastDailyClaimDay) &&
           incoming().lastDailyClaimAt is timestamp &&
           incoming().lastDailyClaimAt > request.time - duration.value(1, 'm') &&
           incoming().lastDailyClaimAt <= request.time &&
           (!('lastDailyClaimAt' in existing()) ||
            (existing().lastDailyClaimAt + duration.value(330, 'm')).date() !=
            (request.time + duration.value(330, 'm')).date()) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'lastDailyClaimDay', 'lastDailyClaimAt', 'xp', 'level', 'updatedAt'])) ||
          (incoming().vipLevel == existing().vipLevel && incoming().coinBalance >= 0 && incoming().coinBalance < existing().coinBalance &&
           incoming().totalGiftsSent is int &&
           incoming().totalGiftsSent > (('totalGiftsSent' in existing()) ? existing().totalGiftsSent : 0) &&
           incoming().totalGiftCoinsSent is int &&
           incoming().totalGiftCoinsSent > (('totalGiftCoinsSent' in existing()) ? existing().totalGiftCoinsSent : 0) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'totalGiftsSent', 'totalGiftCoinsSent', 'xp', 'level', 'updatedAt'])) ||


          (incoming().vipLevel == existing().vipLevel &&
           incoming().coinBalance >= 0 && incoming().coinBalance < existing().coinBalance &&
           incoming().totalGiftsSent is int &&
           incoming().totalGiftsSent > (('totalGiftsSent' in existing()) ? existing().totalGiftsSent : 0) &&
           incoming().totalGiftCoinsSent is int &&
           incoming().totalGiftCoinsSent > (('totalGiftCoinsSent' in existing()) ? existing().totalGiftCoinsSent : 0) &&
           incoming().totalGiftsReceived is int &&
           incoming().totalGiftsReceived > (('totalGiftsReceived' in existing()) ? existing().totalGiftsReceived : 0) &&
           incoming().totalGiftCoinsReceived is int &&
           incoming().totalGiftCoinsReceived > (('totalGiftCoinsReceived' in existing()) ? existing().totalGiftCoinsReceived : 0) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'totalGiftsSent', 'totalGiftCoinsSent', 'totalGiftsReceived', 'totalGiftCoinsReceived', 'xp', 'level', 'updatedAt'])) ||

          (incoming().coinBalance == existing().coinBalance &&
           incoming().vipLevel == existing().vipLevel &&
           incoming().activeFrameId is string &&
           (incoming().activeFrameId == '' ||
            (incoming().ownedFrameIds is list && incoming().activeFrameId in incoming().ownedFrameIds &&
             incoming().frameExpiresAt is map && incoming().frameExpiresAt[incoming().activeFrameId] > request.time)) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['activeFrameId', 'updatedAt'])) ||
          (incoming().coinBalance >= 0 && incoming().coinBalance < existing().coinBalance &&
           incoming().vipLevel >= 1 && incoming().vipLevel <= 8 &&
           (incoming().vipLevel > existing().vipLevel ||
            (!('vipExpiresAt' in existing()) || existing().vipExpiresAt <= request.time)) &&
           incoming().vipExpiresAt is timestamp &&
           incoming().vipExpiresAt > request.time - duration.value(1, 'm') &&
           incoming().vipExpiresAt <= request.time + duration.value(30, 'd') + duration.value(1, 'm') &&
           incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'vipLevel', 'vipExpiresAt', 'updatedAt']))
        )) ||
        (request.auth.uid != userId && incoming().role == existing().role && incoming().accountStatus == existing().accountStatus &&
         incoming().coinBalance == existing().coinBalance && incoming().vipLevel == existing().vipLevel && (
          incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']) ||
          (incoming().totalGiftsReceived is int &&
           incoming().totalGiftsReceived > (('totalGiftsReceived' in existing()) ? existing().totalGiftsReceived : 0) &&
           incoming().totalGiftCoinsReceived is int &&
           incoming().totalGiftCoinsReceived > (('totalGiftCoinsReceived' in existing()) ? existing().totalGiftCoinsReceived : 0) &&
           incoming().diff(existing()).affectedKeys().hasOnly(['totalGiftsReceived', 'totalGiftCoinsReceived', 'xp', 'level', 'updatedAt']))
        ))
      );

      allow delete: if false;

      match /avatar/{avatarDocId} {
        allow get: if isSignedIn() && avatarDocId == 'image';
        allow list: if false;
        allow create, update: if isSignedIn() && request.auth.uid == userId && avatarDocId == 'image' &&
                                 incoming().keys().hasOnly(['data', 'contentType', 'updatedAt']) &&
                                 incoming().data is string && incoming().data.size() <= 960000 &&
                                 incoming().contentType == 'image/jpeg' && isValidTs(incoming().updatedAt);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /private/{docId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId);
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(docId) &&
                                 request.auth.uid == userId &&
                                 isValidPrivateAccount(incoming(), userId) &&
                                 isValidTs(incoming().updatedAt);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Private, non-redeemable arcade progress. This document never changes coinBalance.
      match /game_progress/{gameId} {
        allow get: if isSignedIn() && request.auth.uid == userId && gameId == 'fruit_treasure';
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == userId && gameId == 'fruit_treasure' &&
                         incoming().keys().hasOnly(['score', 'spins', 'dailyBonusDate', 'updatedAt']) &&
                         incoming().keys().hasAll(['score', 'spins', 'dailyBonusDate', 'updatedAt']) &&
                         incoming().score is int && incoming().score >= 0 && incoming().score <= 1000000000 &&
                         incoming().spins is int && incoming().spins >= 0 && incoming().spins <= 10000000 &&
                         incoming().dailyBonusDate is string && incoming().dailyBonusDate.matches('^([0-9]{8})?
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(targetId) &&
                                 request.auth.uid == userId &&
                                 incoming().peerId == targetId &&
                                 isValidFollowEdge(incoming()) &&
                                 isValidTs(incoming().createdAt);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /followers/{followerId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(followerId) &&
                                 request.auth.uid == followerId &&
                                 incoming().peerId == followerId &&
                                 isValidFollowEdge(incoming()) &&
                                 isValidTs(incoming().createdAt);
        allow delete: if isSignedIn() && (request.auth.uid == followerId || request.auth.uid == userId);
      }
    }

    match /room_creation_locks/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidRoomCreationLock(incoming(), userId) &&
                       isValidTs(incoming().createdAt) &&
                       existsAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)) &&
                       (getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.hostId == request.auth.uid ||
                        effectiveRoomOwnerId(getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data) == request.auth.uid);
      allow update, delete: if false;
    }

    match /room_public_ids/{publicRoomId} {
      allow get: if isSignedIn() && publicRoomId.matches('^[0-9]{6}$');
      allow list: if false;
      allow create: if isSignedIn() &&
                       publicRoomId.matches('^[0-9]{6}$') &&
                       isValidId(incoming().roomId) &&
                       isValidTs(incoming().createdAt) &&
                       existsAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)) &&
                       getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.publicRoomId == publicRoomId &&
                       getAfter(/databases/$(database)/documents/rooms/$(incoming().roomId)).data.hostId == request.auth.uid;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (existing().status == 'LIVE' || isRoomManager(existing()));
      allow list: if isSignedIn() && (existing().status == 'LIVE' || isRoomManager(existing()));

      allow create: if isSignedIn() && isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().hostId == request.auth.uid &&
                       (!('ownerId' in incoming()) || incoming().ownerId == request.auth.uid) &&
                       (!('creatorId' in incoming()) || incoming().creatorId == request.auth.uid) &&
                       incoming().status == 'LIVE' &&
                       incoming().featured == false &&
                       isValidTs(incoming().createdAt) &&
                       isValidTs(incoming().updatedAt) &&
                       !exists(/databases/$(database)/documents/room_creation_locks/$(request.auth.uid)) &&
                       (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
                        !('hasCreatedRoom' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasCreatedRoom == false) &&
                       existsAfter(/databases/$(database)/documents/room_creation_locks/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/room_creation_locks/$(request.auth.uid)).data.roomId == roomId &&
                       (!('publicRoomId' in incoming()) ||
                        (existsAfter(/databases/$(database)/documents/room_public_ids/$(incoming().publicRoomId)) &&
                         getAfter(/databases/$(database)/documents/room_public_ids/$(incoming().publicRoomId)).data.roomId == roomId));

      allow update: if isSignedIn() && isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (!('creatorId' in existing()) || incoming().creatorId == existing().creatorId) &&
                       isValidTs(incoming().updatedAt) && (
        (isRoomOwner(existing()) && existing().status == 'LIVE' &&
         incoming().featured == existing().featured &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'announcement', 'category', 'coverKey', 'coverUrl', 'tags', 'locked', 'hasPassword', 'passcodeHash', 'status', 'hostId', 'hostName', 'hostAvatarUrl', 'ownerId', 'ownerName', 'ownerOnline', 'adminIds', 'activeAdminIds', 'listenerCount', 'activeSpeakersCount', 'updatedAt'])) ||
        (isRoomAdminUser(existing()) && existing().status == 'LIVE' &&
         incoming().hostId == existing().hostId &&
         (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId) &&
         (!('ownerOnline' in existing()) || incoming().ownerOnline == existing().ownerOnline) &&
         (!('adminIds' in existing()) || incoming().adminIds == existing().adminIds) &&
         incoming().featured == existing().featured &&
         (incoming().status == existing().status || (incoming().status == 'ENDED' && (!('ownerOnline' in existing()) || existing().ownerOnline == false))) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'announcement', 'category', 'coverKey', 'coverUrl', 'tags', 'locked', 'hasPassword', 'passcodeHash', 'listenerCount', 'activeSpeakersCount', 'activeAdminIds', 'status', 'updatedAt'])) ||
        (existing().status == 'LIVE' &&
         isDirectSpeakerSeatJoin(roomId, incoming()) &&
         incoming().status == existing().status &&
         incoming().hostId == existing().hostId &&
         incoming().featured == existing().featured &&
         incoming().listenerCount == (exists(/databases/$(database)/documents/rooms/$(roomId)/listeners/$(request.auth.uid)) ? (existing().listenerCount > 0 ? existing().listenerCount - 1 : 0) : existing().listenerCount) &&
         incoming().activeSpeakersCount == (existing().activeSpeakersCount < 9 ? existing().activeSpeakersCount + 1 : 9) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['listenerCount', 'activeSpeakersCount', 'lastSpeakerSeatJoinUserId', 'lastSpeakerSeatJoinSeatIndex', 'updatedAt'])) ||
        (existing().status == 'LIVE' && incoming().hostId == existing().hostId &&
         (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId) &&
         (!('ownerOnline' in existing()) || incoming().ownerOnline == existing().ownerOnline) &&
         (!('adminIds' in existing()) || incoming().adminIds == existing().adminIds) &&
         incoming().featured == existing().featured &&
         (incoming().status == existing().status ||
          (incoming().status == 'ENDED' &&
           (!('ownerOnline' in existing()) || existing().ownerOnline == false) &&
           (!('activeAdminIds' in incoming()) || incoming().activeAdminIds.size() == 0))) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['listenerCount', 'activeSpeakersCount', 'activeAdminIds', 'status', 'updatedAt']))
      );

      allow delete: if isSignedIn() && isValidId(roomId) && (
        isRoomOwner(existing()) ||
        (isRoomAdminUser(existing()) && (!('ownerOnline' in existing()) || existing().ownerOnline == false))
      );

      // Strict 9-Seat Stage: 0 = Host, 1..8 = 8 Regular Speaker Seats
      match /seats/{seatIndex} {
        allow get: if isSignedIn() && seatIndex in ['0', '1', '2', '3', '4', '5', '6', '7', '8'];
        allow list: if isSignedIn() && existing().seatIndex >= 0 && existing().seatIndex <= 8;

        allow create: if isSignedIn() &&
                         seatIndex in ['0', '1', '2', '3', '4', '5', '6', '7', '8'] &&
                         isValidSeat(incoming(), seatIndex) &&
                         isValidTs(incoming().updatedAt) &&
                         getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid &&
                         (seatIndex != '0' || incoming().occupantId == request.auth.uid);

        allow update: if isSignedIn() &&
                         seatIndex in ['0', '1', '2', '3', '4', '5', '6', '7', '8'] &&
                         isValidSeat(incoming(), seatIndex) &&
                         isValidTs(incoming().updatedAt) &&
                         (seatIndex != '0' ||
                          incoming().occupantId == getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId ||
                          incoming().occupantId == effectiveRoomOwnerId(getAfter(/databases/$(database)/documents/rooms/$(roomId)).data)) &&
                         (seatIndex == '0' || existing().occupantId == '' || incoming().occupantId == '' || incoming().occupantId == existing().occupantId) && (
          (isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
           (seatIndex == '0' ||
            incoming().occupantId == existing().occupantId ||
            incoming().occupantId == '')) ||
          (seatIndex != '0' && (
            (existing().occupantId == request.auth.uid &&
             (incoming().occupantId == request.auth.uid || incoming().occupantId == '') &&
             incoming().seatLocked == existing().seatLocked &&
             incoming().diff(existing()).affectedKeys().hasOnly(['occupantId', 'occupantName', 'occupantAvatarUrl', 'occupantVipLevel', 'occupantGender', 'muted', 'speaking', 'updatedAt'])) ||
            (existing().occupantId == '' && existing().seatLocked == false &&
             incoming().occupantId == request.auth.uid &&
             incoming().seatLocked == false &&
             exists(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)) &&
             isNotAlreadyOnAnotherSpeakerSeat(roomId, seatIndex) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['occupantId', 'occupantName', 'occupantAvatarUrl', 'occupantVipLevel', 'occupantGender', 'muted', 'speaking', 'updatedAt']))
          ))
        );

        allow delete: if false;
      }

      match /speaker_requests/{requestId} {
        allow get: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || existing().hostId == request.auth.uid || isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data));
        allow list: if isSignedIn() && (existing().userId == request.auth.uid || existing().hostId == request.auth.uid || isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data));
        allow create: if isSignedIn() && isValidId(requestId) &&
                         isValidSpeakerRequest(incoming()) &&
                         incoming().hostId == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId &&
                         isValidTs(incoming().createdAt) &&
                         isValidTs(incoming().updatedAt) &&
                         requestId == incoming().userId &&
                         incoming().status == 'INVITED' &&
                         isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
                         incoming().preferredSeatIndex >= 1 &&
                         incoming().preferredSeatIndex <= 8;
        allow update: if isSignedIn() && isValidId(requestId) &&
                         isValidSpeakerRequest(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().hostId == existing().hostId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTs(incoming().updatedAt) && (
          (existing().status == 'INVITED' &&
           isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
           incoming().status == 'INVITED' &&
           incoming().preferredSeatIndex >= 1 &&
           incoming().preferredSeatIndex <= 8 &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'preferredSeatIndex', 'username', 'avatarUrl', 'vipLevel', 'updatedAt'])) ||
          (existing().status == 'INVITED' &&
           existing().userId == request.auth.uid &&
           incoming().status in ['ACCEPTED', 'REJECTED'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (existing().status != 'PENDING' && existing().status != 'INVITED' &&
           isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
           incoming().status == 'INVITED' &&
           incoming().preferredSeatIndex >= 1 &&
           incoming().preferredSeatIndex <= 8 &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'preferredSeatIndex', 'username', 'avatarUrl', 'vipLevel', 'updatedAt']))
        );
        allow delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().hostId == request.auth.uid || isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data));
      }

      match /messages/{messageId} {
        // A user can only read messages created at or after their latest room join.
        allow get: if isSignedIn() && isValidId(messageId) &&
                      exists(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)) &&
                      existing().createdAt >= get(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)).data.joinedAt &&
                      existing().type in ['TEXT', 'GIFT', 'SYSTEM'];
        allow list: if isSignedIn() &&
                       exists(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)) &&
                       existing().createdAt >= get(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)).data.joinedAt &&
                       existing().type in ['TEXT', 'GIFT', 'SYSTEM'];
        allow create: if isSignedIn() && isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         isValidRoomMessage(incoming()) &&
                         isValidTs(incoming().createdAt) &&
                         existsAfter(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid));
        allow update, delete: if false;
      }

      match /room_sessions/{sessionUserId} {
        allow get: if isSignedIn() && sessionUserId == request.auth.uid;
        // Room UI observes active room sessions to keep seat/listener presence accurate.
        // Only signed-in users may list sessions while the parent room is live.
        allow list: if isSignedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'LIVE';
        allow create: if isSignedIn() && sessionUserId == request.auth.uid &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().joinedAt is timestamp &&
                                 incoming().joinedAt == request.time &&
                                 incoming().keys().hasOnly(['userId', 'joinedAt', 'lastSeenAt']) &&
                                 (!('lastSeenAt' in incoming()) ||
                                  (incoming().lastSeenAt is timestamp && incoming().lastSeenAt == request.time));
        allow update: if isSignedIn() && sessionUserId == request.auth.uid &&
                                 incoming().userId == existing().userId &&
                                 (
                                   (incoming().joinedAt is timestamp &&
                                    incoming().joinedAt == request.time &&
                                    incoming().keys().hasOnly(['userId', 'joinedAt', 'lastSeenAt']) &&
                                    (!('lastSeenAt' in incoming()) ||
                                     (incoming().lastSeenAt is timestamp && incoming().lastSeenAt == request.time))) ||
                                   (incoming().joinedAt == existing().joinedAt &&
                                    incoming().lastSeenAt is timestamp &&
                                    incoming().lastSeenAt == request.time &&
                                    incoming().diff(existing()).affectedKeys().hasOnly(['lastSeenAt']))
                                 );
        allow delete: if isSignedIn() && sessionUserId == request.auth.uid;
      }

      match /listeners/{listenerId} {
        allow get: if isSignedIn() && isValidId(listenerId);
        allow list: if isSignedIn() && existing().role == 'LISTENER';
        allow create, update: if isSignedIn() && isValidId(listenerId) &&
                                 listenerId == request.auth.uid &&
                                 incoming().userId == request.auth.uid &&
                                 isValidRoomListener(incoming()) &&
                                 isValidTs(incoming().joinedAt);
        allow delete: if isSignedIn() && (listenerId == request.auth.uid || isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data));
      }
    }

    match /conversations/{conversationId} {
      // Signed-in users may check whether a deterministic conversation ID exists.
      // Existing conversations remain readable only by their participants.
      allow get: if isSignedIn() && isValidId(conversationId) &&
                   (!exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
                    request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;
      allow create: if isSignedIn() && isValidId(conversationId) &&
                       request.auth.uid in incoming().participantIds &&
                       (!('conversationType' in incoming()) || incoming().conversationType == 'DIRECT' || incoming().ownerId == request.auth.uid) &&
                       isValidConversation(incoming()) &&
                       isValidTs(incoming().createdAt) &&
                       isValidTs(incoming().updatedAt);
      allow update: if isSignedIn() && isValidId(conversationId) &&
