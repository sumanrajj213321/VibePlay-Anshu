                           (incoming().senderId == 'VIBEPLAY_OFFICIAL_BOT' &&
                            incoming().type == 'SYSTEM' &&
                            messageId == 'welcome_10_lakh_bonus' &&
                            incoming().recipientId is string &&
                            incoming().text == '🎉 10 LAKH COINS WELCOME BONUS!\n\nCongratulations! 🥳 VibePlay ki taraf se aapke account mein 10,00,000 bonus coins add kiye gaye hain.\n\n❤️ Enjoy VibePlay, send gifts and have fun!\n\n— Team VibePlay' &&
                            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.size() == 2 &&
                            incoming().recipientId in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                            'VIBEPLAY_OFFICIAL_BOT' in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                            (request.auth.uid == incoming().recipientId) &&
