                         incoming().userId == existing().userId &&
                         incoming().hostId == existing().hostId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTs(incoming().updatedAt) && (
          (existing().status == 'INVITED' &&
           isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
           incoming().status == 'INVITED' &&
           incoming().preferredSeatIndex >= 1 &&
           incoming().preferredSeatIndex <= 8 &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'preferredSeatIndex', 'username', 'avatarUrl', 'vipLevel', 'updatedAt'])) ||
          (existing().status == 'INVITED' &&
           existing().userId == request.auth.uid &&
           incoming().status in ['ACCEPTED', 'REJECTED'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (existing().status != 'PENDING' && existing().status != 'INVITED' &&
           isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
           incoming().status == 'INVITED' &&
           incoming().preferredSeatIndex >= 1 &&
           incoming().preferredSeatIndex <= 8 &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'preferredSeatIndex', 'username', 'avatarUrl', 'vipLevel', 'updatedAt']))
        );
        allow delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().hostId == request.auth.uid || isRoomManager(get(/databases/$(database)/documents/rooms/$(roomId)).data));
      }

      match /messages/{messageId} {
        // A user can only read messages created at or after their latest room join.
        allow get: if isSignedIn() && isValidId(messageId) &&
                      exists(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)) &&
                      existing().createdAt >= get(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)).data.joinedAt &&
                      existing().type in ['TEXT', 'GIFT', 'SYSTEM'];
        allow list: if isSignedIn() &&
                       exists(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)) &&
                       existing().createdAt >= get(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid)).data.joinedAt &&
                       existing().type in ['TEXT', 'GIFT', 'SYSTEM'];
        allow create: if isSignedIn() && isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         isValidRoomMessage(incoming()) &&
                         isValidTs(incoming().createdAt) &&
                         existsAfter(/databases/$(database)/documents/rooms/$(roomId)/room_sessions/$(request.auth.uid));
        allow update, delete: if false;
      }

      match /room_sessions/{sessionUserId} {
        allow get: if isSignedIn() && sessionUserId == request.auth.uid;
        // Room UI observes active room sessions to keep seat/listener presence accurate.
        // Only signed-in users may list sessions while the parent room is live.
        allow list: if isSignedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'LIVE';
        allow create: if isSignedIn() && sessionUserId == request.auth.uid &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().joinedAt is timestamp &&
                                 incoming().joinedAt == request.time &&
                                 incoming().keys().hasOnly(['userId', 'joinedAt', 'lastSeenAt']) &&
                                 (!('lastSeenAt' in incoming()) ||
                                  (incoming().lastSeenAt is timestamp && incoming().lastSeenAt == request.time));
        allow update: if isSignedIn() && sessionUserId == request.auth.uid &&
                                 incoming().userId == existing().userId &&
                                 (
                                   (incoming().joinedAt is timestamp &&
