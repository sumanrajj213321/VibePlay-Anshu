      );
      allow delete: if isSignedIn() && isValidId(conversationId) && (('ownerId' in existing() && existing().ownerId == request.auth.uid) || (request.auth.uid in existing().participantIds && existing().participantIds.size() <= 1));

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() && isValidId(messageId) &&
                         isValidDirectMessage(incoming()) &&
                         isValidTs(incoming().createdAt) && (
