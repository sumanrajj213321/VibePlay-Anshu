        (('conversationType' in existing() && existing().conversationType == 'GROUP') &&
         (('ownerId' in existing() && existing().ownerId == request.auth.uid) ||
          ('adminIds' in existing() && request.auth.uid in existing().adminIds)) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['groupName', 'groupAvatarUrl', 'participantIds', 'participantNames', 'participantAvatars', 'adminIds', 'ownerId', 'lastMessage', 'lastSenderId', 'unreadBy', 'updatedAt'])) ||
        (('conversationType' in existing() && existing().conversationType == 'GROUP') &&
