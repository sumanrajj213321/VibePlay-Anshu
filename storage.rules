rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Curated gift media is readable by signed-in users; only project admins upload it.
    match /gift-assets/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Moments: authenticated users can view; owner uploads photos/videos up to 1 MB.
    match /moments/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size > 0
                   && request.resource.size <= 1 * 1024 * 1024
                   && ((request.resource.contentType == 'image/jpeg'
                        && fileName.matches('.*\\.jpg'))
                       || (request.resource.contentType == 'video/mp4'
                           && fileName.matches('.*\\.mp4')));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /profile-covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Inbox photos are stored in cloud storage so they survive logout and reinstall.
    // Only signed-in participants of the conversation can read them; only the sender can upload.
    match /chat-images/{conversationId}/{senderId}/{fileName} {
      function conversationData() {
        return firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
      }
      allow read: if request.auth != null
                  && request.auth.uid in conversationData().participantIds;
      allow write: if request.auth != null
                   && request.auth.uid == senderId
                   && request.auth.uid in conversationData().participantIds
                   && request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == senderId
                    && request.auth.uid in conversationData().participantIds;
    }

    match /room-covers/{roomId}/{fileName} {
      function roomData() {
        return firestore.get(/databases/(default)/documents/rooms/$(roomId)).data;
      }
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && (roomData().hostId == request.auth.uid
                       || roomData().ownerId == request.auth.uid
                       || (roomData().adminIds is list && request.auth.uid in roomData().adminIds));
      allow delete: if request.auth != null
                    && (roomData().hostId == request.auth.uid
                        || roomData().ownerId == request.auth.uid
                        || (roomData().adminIds is list && request.auth.uid in roomData().adminIds));
    }
  }
}