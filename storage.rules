rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /room-covers/{roomId}/{fileName} {
      function roomData() {
        return firestore.get(/databases/(default)/documents/rooms/$(roomId)).data;
      }
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && (roomData().hostId == request.auth.uid
                       || roomData().ownerId == request.auth.uid
                       || (roomData().adminIds is list && request.auth.uid in roomData().adminIds));
      allow delete: if request.auth != null
                    && (roomData().hostId == request.auth.uid
                        || roomData().ownerId == request.auth.uid
                        || (roomData().adminIds is list && request.auth.uid in roomData().adminIds));
    }
  }
}